# ==========================================
# PERFORMX Environment Configuration Template
# Copy this file to .env and provide your project values.
# NEVER commit .env to version control!
# ==========================================

# Environment Mode ('development', 'production', 'test')
# In 'production', PERFORMX_STORAGE_BACKEND='memory' is strictly rejected.
PERFORMX_ENV=development

# Server Binding (PaaS hosts like Render/Fly automatically set PORT)
PORT=8000
HOST=0.0.0.0

# Supabase Project Configuration
# Retrieve from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# JWT Cryptographic Verification Configuration
# Option A (Symmetric HS256): Supabase Dashboard > Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Option B (Asymmetric RS256/ES256): Supabase Public PEM Key (if using asymmetric signing)
# SUPABASE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Optional JWT Issuer override (defaults to ${SUPABASE_URL}/auth/v1)
# SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Storage Backend ('supabase' for production cloud, 'memory' for local test runs)
# Set to 'supabase' in production!
PERFORMX_STORAGE_BACKEND=memory

# Production CORS Origins (comma-separated list of allowed web frontend domains)
# e.g., https://your-performx-app.vercel.app,http://localhost:3000
PERFORMX_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Grounded AI Coach LLM Provider Configuration (Optional, Server-side Only)
# Option 1: Google Gemini (default model: gemini-1.5-flash)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-1.5-flash

# Option 2: OpenAI (default model: gpt-4o-mini)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# Note: If no LLM provider key is set, the assistant runs in grounded deterministic mode
# with zero external network dependencies and identical safety guardrails.

