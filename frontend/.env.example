# PERFORMX Frontend Environment Configuration
# API base URL pointing to the FastAPI backend (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Supabase Auth Configuration (Client-side / Anon Key only)
# Retrieve from: Supabase Dashboard > Project Settings > API
# WARNING: NEVER place service_role keys or SUPABASE_JWT_SECRET in VITE_ variables!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
